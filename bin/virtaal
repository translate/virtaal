import sys

# A frozen build has no separate "python" executable to hand "-m" to
# for launching a helper subprocess (see localtm.py's tmserver) -
# sys.executable there *is* this launcher. Dispatch via runpy instead.
# Has to stay here, before virtaal.cli's own imports - PyInstaller
# reaches this same file to launch the subprocess itself.
if len(sys.argv) > 2 and sys.argv[1] == '--run-module':
    import runpy
    module_name = sys.argv[2]
    sys.argv = sys.argv[2:]
    # For a CI check that may hang: every thread's stack, after a delay.
    import os
    stack_dump = os.environ.get('VIRTAAL_STACK_DUMP')
    if stack_dump:
        import faulthandler
        delay, path = stack_dump.split(':', 1)
        faulthandler.dump_traceback_later(int(delay), file=open(path, 'w'))
    runpy.run_module(module_name, run_name='__main__')
    sys.exit(0)

if __name__ == "__main__":
    try:
        from virtaal.cli import main
        main(sys.argv)
    except KeyboardInterrupt:
        # Ctrl-C shouldn't dump a traceback. os._exit(), not sys.exit():
        # the latter's interpreter finalization forces a gc.collect()
        # despite Virtaal's gc.disable(), reproducing the GTK teardown
        # segfault os._exit(0) dodges on the normal-quit path (main.py).
        import os
        os._exit(130)
