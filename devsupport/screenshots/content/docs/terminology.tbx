<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<!--
  A small English -> Afrikaans TBX glossary, purpose-built for
  docs/screenshots.rst's Terminology Assistance screenshot (issue
  #3746), not a reuse of workflow.tbx. Two termEntry blocks share the
  same source term ("Cancel") with two different Afrikaans targets -
  Virtaal's TerminologyPlaceable only offers the insert-combo (rather
  than inserting a single match straight away) when more than one
  translation is available for the same term, which this deliberately
  exercises.
-->
<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Translate Toolkit</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Cancel</term></tig></langSet>
                <langSet xml:lang="af"><tig><term>Kanselleer</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Cancel</term></tig></langSet>
                <langSet xml:lang="af"><tig><term>Herroep</term></tig></langSet>
            </termEntry>
        </body>
    </text>
</martif>
