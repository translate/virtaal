#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"

desktop=share/applications/io.github.translate.Virtaal.desktop
metainfo=share/metainfo/io.github.translate.Virtaal.metainfo.xml
mimetype=share/mime/packages/virtaal-mimetype.xml

# GETTEXTDATADIRS: po/its/ holds a custom ITS rule for
# virtaal-mimetype.xml.in - shared-mime-info XML has no rule built
# into gettext itself, unlike .desktop/GtkBuilder/AppStream.
gettextdatadirs="$(pwd)/po${GETTEXTDATADIRS:+:$GETTEXTDATADIRS}"
export GETTEXTDATADIRS="$gettextdatadirs"

msgfmt --xml --template "$mimetype".in -d po -o "$mimetype"
msgfmt --xml --template "$metainfo".in -d po -o "$metainfo"
msgfmt --desktop --template "$desktop".in -d po -o "$desktop"
