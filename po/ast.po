#: share/virtaal/virtaal.ui
msgid ""
"The <b>Original</b> is the language from which you are translating, also "
"called the source language.\n"
"\n"
"If you are translating from English to French then English would be your "
"original or source language."
msgstr ""
"L'<b>Orixinal</b> ye l'idioma del que tas traduciendo, tamién nomáu llingua "
"fonte.\n"
"\n"
"Si tas traduciendo dende l'inglés al francés, l'inglés sedría l'orixinal o "
"llingua fonte."

#: share/virtaal/virtaal.ui
msgid "<b>Original</b>"
msgstr "<b>Orixinal</b>"

#: share/virtaal/virtaal.ui
msgid ""
"The <b>Translation</b> is the language into which you are translating, also "
"called the target language.\n"
"\n"
"If you are translating from English to French then French would be your "
"translation or target language."
msgstr ""
"La <b>Traducción</b> ye la llingua a la que tas traduciendo, tamién llamada "
"llingua destín.\n"
"\n"
"Si tas traduciendo dende l'inglés al francés. el francés sedría la "
"traducción o llingua destín."

