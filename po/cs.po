#: virtaal/views/widgets/shortcutswindow.py
msgid "Show this Keyboard Shortcuts window"
msgstr "Zobrazit okno klávesových skratek"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Navigation"
msgstr "Procházení"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to next translation"
msgstr "Přejít na další překlad"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to previous unit"
msgstr "Přejít na předchozí položku"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to next unit"
msgstr "Přejít na další položku"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move 10 units up"
msgstr "Přejít o 10 položek výše"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move 10 units down"
msgstr "Přejít o 10 položek níže"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to first unit"
msgstr "Přejít na první položku"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to last unit"
msgstr "Přejít na poslední položku"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to next search match"
msgstr "Přejít na další výsledek hledání"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to previous search match"
msgstr "Přejít na předchozí výsledek hledání"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Units"
msgstr "Položky"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Select previous placeable"
msgstr "Vybrat předchozí aktivní řetězec"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Select next placeable"
msgstr "Vybrat následující aktivní řetězec"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Insert the selected placeable"
msgstr "Vložit vybraný aktivní řetězec"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Replace the translation with the source"
msgstr "Nahradit překlad zdrojovým textem"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Copy the source, if nothing is selected"
msgstr "Pokud není nic vybráno, zkopírovat zdrojový text"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Enter a new line"
msgstr "Vložit odřádkování"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Undo the last change"
msgstr "Vrátit zpět poslední změnu"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Redo the last undone change"
msgstr "Obnovit vrácenou změnu"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Use the first translation suggestion"
msgstr "Použít první návrh překladu"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Show/Hide checks"
msgstr "Zobrazit / skrýt kontroly"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Show translation suggestions for this unit"
msgstr "Zobrazit návrhy překladu pro tuto položku"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Turn translation suggestions on or off"
msgstr "Zapnout nebo vypnout návrhy překladu"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Hide translation suggestions, if shown"
msgstr "Skrýt zobrazené návrhy překladu"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Add a term to the local terminology file"
msgstr "Přidat výraz do souboru místní terminologie"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Moving focus"
msgstr "Přesun aktivního vstupu"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to the next target field"
msgstr "Přejít na další cílové pole"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to the previous target field"
msgstr "Přejít na předchozí cílové pole"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Jump to the language-pair selector"
msgstr "Přejít na výběr jazykového páru"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Jump to the \"Navigation:\" mode selector"
msgstr "Přejít na výběr možností \"Procházení\""

#: virtaal/views/widgets/shortcutswindow.py
msgid "Close the search bar and return to normal editing"
msgstr "Zavřít panel hledání, vrátit se k běžné editaci"

#: virtaal/views/widgets/welcomescreen.py
msgid "Translation memory"
msgstr "Překladová paměť"

#: virtaal/views/widgets/welcomescreen.py
msgid "Machine translation"
msgstr "Strojový překlad"

#: virtaal/views/widgets/welcomescreen.py
msgid "Highlighting and insertion of placeables"
msgstr "Označování a vkládání aktivních řetězců"

#: virtaal/views/widgets/welcomescreen.py
msgid "Many plugins and options for customization"
msgstr "Mnoho rozšíření a možností přizpůsobení"

