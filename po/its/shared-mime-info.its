<?xml version="1.0"?>
<!--
No built-in gettext ITS rule exists for shared-mime-info XML (unlike
.desktop, GtkBuilder, or AppStream metainfo) - this fills that gap so
xgettext/msgfmt recognise virtaal-mimetype.xml.in as ITS-governed XML
at all. The real shared-mime-info package ships its own gettext rules
under this same name (/usr/share/gettext/its/shared-mime-info.its) -
present on most real build machines - so which external rule actually
applies here isn't reliable. virtaal-mimetype.xml.in carries its own
its:translate markup per element instead; that always wins over
either external rule, per the ITS 2.0 precedence for local markup.
-->
<its:rules xmlns:its="http://www.w3.org/2005/11/its" version="2.0">
  <its:translateRule selector="/mime-info" translate="no"/>
</its:rules>
