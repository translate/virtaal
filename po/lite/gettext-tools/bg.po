#: src/format-awk.c:530
#: src/format-boost.c:642
#: src/format-c++-brace.c:955
#: src/format-elisp.c:370
#: src/format-gcc-internal.c:795
#: src/format-go.c:595
#: src/format-java-printf.c:571
#: src/format-javascript.c:392
#: src/format-kde.c:227
#: src/format-librep.c:334
#: src/format-lua.c:234
#: src/format-modula2.c:205
#: src/format-ocaml.c:913
#: src/format-pascal.c:391
#: src/format-perl.c:599
#: src/format-php.c:372
#: src/format-qt.c:167
#: src/format-rust.c:507
#: src/format-sh-printf.c:483
#: src/format-smalltalk.c:142
#: src/format-tcl.c:409
#, c-format
msgid "a format specification for argument %zu doesn't exist in '%s'"
msgstr "указаният формат за аргумент %zu не съществува за '%s'"

#: src/format-awk.c:554
#: src/format-boost.c:666
#: src/format-c.c:148
#: src/format-elisp.c:394
#: src/format-gcc-internal.c:819
#: src/format-gfc-internal.c:353
#: src/format-go.c:619
#: src/format-java-printf.c:595
#: src/format-javascript.c:419
#: src/format-librep.c:358
#: src/format-lua.c:248
#: src/format-modula2.c:219
#: src/format-ocaml.c:946
#: src/format-pascal.c:415
#: src/format-perl.c:623
#: src/format-php.c:396
#: src/format-python.c:547
#: src/format-ruby.c:965
#: src/format-sh-printf.c:507
#: src/format-tcl.c:433
#, c-format
msgid ""
"format specifications in '%s' and '%s' for argument %zu are not the same"
msgstr "не са еднакви указаните формати при '%s' и при '%s' за аргумент %zu"

#: src/format-boost.c:452
#, c-format
msgid "The directive number %zu starts with | but does not end with |."
msgstr "Директива номер %zu започва с |, но не завършва с |."

#: src/format.c:160
#, c-format
msgid "'%s' is not a valid %s format string, unlike '%s'. Reason: %s"
msgstr "'%s' е неправилен %s форматиращ низ, за разлика от '%s'. Причина: %s"

#: src/format-c++-brace.c:252
#, c-format
msgid "In the directive number %zu, the arg-id is too large."
msgstr "При директива номер %zu, аргумента е твърде голям."

#: src/format-c++-brace.c:368
#: src/format-c++-brace.c:463
#, c-format
msgid "In the directive number %zu, the width's arg-id is too large."
msgstr "При директива номер %zu, ширината е твърде голяма."

#: src/format-c++-brace.c:423
#, c-format
msgid ""
"In the directive number %zu, the width's arg-id is not terminated through '}"
"'."
msgstr "При директива номер %zu, ширината не е затворена с '}'."

#: src/format-c++-brace.c:518
#, c-format
msgid ""
"In the directive number %zu, the precision's arg-id is not terminated "
"through '}'."
msgstr "При директива номер %zu, точността не е затворена с '}'."

#: src/format-c++-brace.c:580
#, c-format
msgid ""
"In the directive number %zu, the character '%c' is not a standard type "
"specifier."
msgstr "При директива номер %zu, знакът '%c' не задава стандартен тип."

#: src/format-c++-brace.c:581
#, c-format
msgid ""
"The character that terminates the directive number %zu is not a standard "
"type specifier."
msgstr "Знакът, който прекратява директива номер %zu, не задава стандартен тип."

#: src/format-c++-brace.c:589
#, c-format
msgid ""
"In the directive number %zu, the sign specification is incompatible with the "
"type specifier '%c'."
msgstr ""
"При директива номер %zu, задаването на знак не е съвместимо със зададения "
"стандартен тип '%c'."

#: src/format-c++-brace.c:597
#, c-format
msgid ""
"In the directive number %zu, the '#' option is incompatible with the type "
"specifier '%c'."
msgstr ""
"При директива номер %zu, опцията '#' не е съвместимо със зададения "
"стандартен тип '%c'."

#: src/format-c++-brace.c:605
#, c-format
msgid ""
"In the directive number %zu, the '0' option is incompatible with the type "
"specifier '%c'."
msgstr ""
"При директива номер %zu, опцията '0' не е съвместимо със зададения "
"стандартен тип '%c'."

#: src/format-c++-brace.c:613
#, c-format
msgid ""
"In the directive number %zu, the precision specification is incompatible "
"with the type specifier '%c'."
msgstr ""
"При директива номер %zu, зададената точност не е съвместима със зададения "
"стандартен тип '%c'."

#: src/format-c++-brace.c:621
#, c-format
msgid ""
"In the directive number %zu, the 'L' option is incompatible with the type "
"specifier '%c'."
msgstr ""
"При директива номер %zu, опцията 'L' не е съвместимо със зададения "
"стандартен тип '%c'."

#: src/format-c++-brace.c:722
#, c-format
msgid ""
"The directive number %zu, with all of its options, is not applicable to any "
"type."
msgstr ""
"При директива номер %zu, заедно с всичките опции, не са приложими за нито "
"един тип."

#: src/format-c++-brace.c:734
#, c-format
msgid "The string ends in the middle of the directive number %zu."
msgstr "Низът завършва по средата на директива номер %zu."

#: src/format-c++-brace.c:742
#, c-format
msgid "The directive number %zu is not terminated through '}'."
msgstr "Директива номер %zu не е завършена с '}'."

#: src/format-c++-brace.c:764
#: src/format-csharp.c:155
#: src/format-java.c:344
msgid ""
"The string starts in the middle of a directive: found '}' without matching '"
"{'."
msgstr "Низът започва по средата на директива : намерено '}' без съответен '{'."

#: src/format-c++-brace.c:765
#: src/format-csharp.c:156
#, c-format
msgid "The string contains a lone '}' after directive number %zu."
msgstr "Низът съдържа самотен '}' след директива номер %zu."

#: src/format-c++-brace.c:984
#, c-format
msgid ""
"The format specification for argument %zu in '%s' is applicable to the types "
"%s, but the format specification for argument %zu in '%s' is not."
msgstr ""
"Указаният формат за аргумент %zu в '%s', е приложим за видовете %s, но "
"указаният формат за аргумент %zu в '%s' не е."

#: src/format-c++-brace.c:997
#, c-format
msgid ""
"The format specification for argument %zu in '%s' uses a different "
"presentation than the format specification for argument %zu in '%s'."
msgstr ""
"Указаният формат за аргумент %zu в '%s', използва различно представяне "
"спрямо указаният формат за аргумент %zu в '%s'."

#: src/format-c.c:35
#, c-format
msgid ""
"In the directive number %zu, the token after '<' is not the name of a format "
"specifier macro. The valid macro names are listed in ISO C 99 section 7.8.1."
msgstr ""
"При директива номер %zu, частта след '<' не е име на форматиращ макрос. "
"Правилните имена на макроси са изброени в ИСО Си 99 дял 7.8.1."

#: src/format-c.c:38
#, c-format
msgid ""
"In the directive number %zu, the token after '<' is not followed by '>'."
msgstr "В директива номер %zu, частта след '<' не е завършена с '>'."

#: src/format-c.c:41
#, c-format
msgid "In the directive number %zu, the argument size specifier is invalid."
msgstr "При директива номер %zu, аргумента задаващ размера не е правилен."

#: src/format-c.c:44
#: src/format-gfc-internal.c:274
#, c-format
msgid ""
"The string refers to argument number %zu but ignores argument number %zu."
msgstr ""
"Низът указва към аргумент номер %zu, но пренебрегва аргумент номер  %zu."

#: src/format-c.c:138
#: src/format-csharp.c:201
#: src/format-gfc-internal.c:343
#: src/format-python.c:534
#: src/format-qt-plural.c:109
#: src/format-ruby.c:955
#, c-format
msgid "number of format specifications in '%s' and '%s' does not match"
msgstr "не съвпада указания брой на формати при '%s' и при '%s'"

#: src/format-csharp.c:82
#: src/format-java.c:203
#, c-format
msgid "In the directive number %zu, '{' is not followed by an argument number."
msgstr "При директива номер %zu, '{' не е последван от номер на аргумент."

#: src/format-csharp.c:103
#, c-format
msgid "In the directive number %zu, ',' is not followed by a number."
msgstr "При директива номер %zu, ',' не е последван от число."

#: src/format-csharp.c:124
#: src/format-java.c:185
msgid ""
"The string ends in the middle of a directive: found '{' without matching '}'."
msgstr ""
"Низът завършва по средата на директивата: намерено '{' без съответен '}'."

#: src/format-csharp.c:133
#, c-format
msgid ""
"The directive number %zu ends with an invalid character '%c' instead of '}'."
msgstr "Директива номер %zu завършва с неправилен знак '%c' вместо '}'."

#: src/format-csharp.c:134
#, c-format
msgid "The directive number %zu ends with an invalid character instead of '}'."
msgstr "Директива номер %zu завършва с неправилен знак вместо '}'."

#: src/format-d.c:1651
#, c-format
msgid ""
"In the directive number %zu, the first argument number is greater than the "
"second argument number."
msgstr "При директива номер %zu, първият аргумент е по-голям от втория."

#: src/format-d.c:1654
#, c-format
msgid ""
"In the directive number %zu, the compound specifier consumes a variable "
"number of arguments."
msgstr "При директива номер %zu, съставната използва променлив брой аргументи."

#: src/format-d.c:1657
#, c-format
msgid ""
"In the directive number %zu, the compound specifier consumes %zu arguments."
msgstr "При директива номер %zu, съставната използва %zu аргументи."

#: src/format-d.c:1660
msgid "Found '%|' outside of '%(...%)'."
msgstr "Намерен '%|' извън '%(...%)'."

#: src/format-d.c:1663
msgid "The string ends in the middle of a compound specifier."
msgstr "Низът завършва по средата на съставната."

#: src/format-d.c:1666
#, c-format
msgid ""
"In the directive number %zu, there is an invalid directive in the delimiter "
"part of a compound specifier."
msgstr ""
"При директива номер %zu, има неправилна директива в разделящата част на "
"съставната."

#: src/format-d.c:1669
#: src/format-ocaml.c:768
#, c-format
msgid "Found '%%%c' without matching '%%%c'."
msgstr "Намерен '%%%c' без съответен '%%%c'."

#: src/format-d.c:1672
#, c-format
msgid ""
"The directive number %zu references an argument after the last argument."
msgstr "При директива номер %zu се указва аргумент след последния."

#: src/format-d.c:1676
#: src/format-lisp.c:3419
#: src/format-scheme.c:3341
msgid "The string refers to some argument in incompatible ways."
msgstr "Низът указва към някои аргументи по несъвместими начини."

#: src/format-d.c:2246
#: src/format-lisp.c:3462
#: src/format-scheme.c:3384
#, c-format
msgid "format specifications in '%s' and '%s' are not equivalent"
msgstr "не са равностойни указаните формати при '%s' и при '%s'"

#: src/format-d.c:2263
#: src/format-lisp.c:3479
#: src/format-scheme.c:3401
#, c-format
msgid "format specifications in '%s' are not a subset of those in '%s'"
msgstr "указаните формати при '%s' не са подмножество на тези при '%s'"

#: src/format-gcc-internal.c:228
#, c-format
msgid ""
"The directive number %zu opens a quote group, but the previous one is not "
"terminated."
msgstr ""
"При директива номер %zu, отваря нови кавички, но предишните не са затворени."

#: src/format-gcc-internal.c:238
#: src/format-gcc-internal.c:248
#: src/format-gcc-internal.c:258
#, c-format
msgid "The directive number %zu does not match a preceding '%%%c'."
msgstr "Директива номер %zu не съвпада с предходен '%%%c'."

#: src/format-gcc-internal.c:344
#, c-format
msgid "In the directive number %zu, the flags combination is invalid."
msgstr "При директива номер %zu, комбинацията от флагове не е правилна."

#: src/format-gcc-internal.c:385
#, c-format
msgid "In the directive number %zu, a precision is not allowed before '%c'."
msgstr "При директива номер %zu, точност не е разрешена преди '%c'."

#: src/format-gcc-internal.c:426
#, c-format
msgid ""
"In the directive number %zu, the argument number for the precision must be "
"equal to %zu."
msgstr ""
"При директива номер %zu, числото за точност трябва да бъде равно на %zu."

#: src/format-gcc-internal.c:490
#, c-format
msgid ""
"In the directive number %zu, a precision specification is not allowed before "
"'%c'."
msgstr ""
"При директива номер %zu, указването на точност не е разрешено преди '%c'."

#: src/format-gcc-internal.c:498
#, c-format
msgid "In the directive number %zu, the precision specification is invalid."
msgstr "При директива номер %zu, точността не се зададена правилно."

#: src/format-gcc-internal.c:524
#, c-format
msgid ""
"The directive number %zu opens a color group, but the previous one is not "
"terminated."
msgstr ""
"При директива номер %zu, отваря \"цветна\"-група, но предишната не е "
"затворена."

#: src/format-gcc-internal.c:535
#, c-format
msgid ""
"The directive number %zu opens a URL group, but the previous one is not "
"terminated."
msgstr ""
"При директива номер %zu, отваря \"адресна\"-група, но предишната не е "
"затворена."

#: src/format-gcc-internal.c:663
#, c-format
msgid "The quote group opened by the directive number %zu is not terminated."
msgstr "Кавичките, отворени от директива номер %zu, не са затворени."

#: src/format-gcc-internal.c:668
#, c-format
msgid "The color group opened by the directive number %zu is not terminated."
msgstr "\"Цветната\"-група, отворена от директива номер %zu, не е затворена."

#: src/format-gcc-internal.c:673
#, c-format
msgid "The URL group opened by the directive number %zu is not terminated."
msgstr "\"Адресната\"-група, отворена от директива номер %zu, не е затворена."

#: src/format-gcc-internal.c:840
#, c-format
msgid "'%s' uses %%m but '%s' doesn't"
msgstr "'%s' използва %%m, а '%s' не"

#: src/format-gcc-internal.c:844
#, c-format
msgid "'%s' does not use %%m but '%s' uses %%m"
msgstr "'%s' не използва %%m, а '%s' използва %%m"

#: src/format-gcc-internal.c:857
#: src/format-gfc-internal.c:365
#, c-format
msgid "'%s' uses %%C but '%s' doesn't"
msgstr "'%s' използва %%C, но '%s' не"

#: src/format-gcc-internal.c:861
#: src/format-gfc-internal.c:369
#, c-format
msgid "'%s' does not use %%C but '%s' uses %%C"
msgstr "'%s' не използва %%C, но '%s' използва %%C"

#: src/format-go.c:115
#: src/format-rust.c:172
#, c-format
msgid "In the directive number %zu, the argument number is too large."
msgstr "При директива номер %zu, аргумента е твърде голям."

#: src/format-go.c:221
#, c-format
msgid "In the directive number %zu, the width is too large."
msgstr "При директива номер %zu, ширината е твърде голяма."

#: src/format-go.c:326
#, c-format
msgid "In the directive number %zu, the precision is too large."
msgstr "При директива номер %zu, точността е твърде голяма."

#: src/format-invalid.h:23
msgid "The string ends in the middle of a directive."
msgstr "Низът завършва по средата на директива."

#: src/format-invalid.h:26
msgid ""
"The string refers to arguments both through absolute argument numbers and "
"through unnumbered argument specifications."
msgstr ""
"Низът указва аргументи и чрез номер на аргумент, и чрез неномерирано "
"задаване на аргумент."

#: src/format-invalid.h:29
#, c-format
msgid "In the directive number %zu, the precision is missing."
msgstr "При директива номер %zu, не е зададена точността."

#: src/format-invalid.h:32
#, c-format
msgid ""
"In the directive number %zu, the argument number 0 is not a positive integer."
msgstr "При директива номер %zu, аргумент номер 0 не е цяло положително число."

#: src/format-invalid.h:34
#, c-format
msgid ""
"In the directive number %zu, the width's argument number 0 is not a positive "
"integer."
msgstr ""
"При директива номер %zu, ширината за аргумент номер 0 не е цяло положително "
"число."

#: src/format-invalid.h:36
#, c-format
msgid ""
"In the directive number %zu, the precision's argument number 0 is not a "
"positive integer."
msgstr ""
"При директива номер %zu, точността за аргумент номер 0 не е цяло положително "
"число."

#: src/format-invalid.h:40
#, c-format
msgid ""
"In the directive number %zu, the character '%c' is not a valid conversion "
"specifier."
msgstr "При директива номер %zu, знакът '%c' не е валиден за превръщане."

#: src/format-invalid.h:41
#, c-format
msgid ""
"The character that terminates the directive number %zu is not a valid "
"conversion specifier."
msgstr ""
"Знакът, който прекратява директива номер %zu, не е валиден за превръщане."

#: src/format-invalid.h:44
#, c-format
msgid ""
"In the directive number %zu, the flag '%c' is invalid for the conversion "
"'%c'."
msgstr "При директива номер %zu не е правилен знака '%c'за превръщане '%c'."

#: src/format-invalid.h:47
#, c-format
msgid "The string refers to argument number %zu in incompatible ways."
msgstr "Низът указва към аргумент с номер %zu по несъвместим начин."

#: src/format-java.c:238
#, c-format
msgid ""
"In the directive number %zu, the substring \"%s\" is not a valid date/time "
"style."
msgstr "При директива номер %zu, низът \"%s\" не е правилен за дата/час."

#: src/format-java.c:249
#: src/format-java.c:283
#: src/format-java.c:312
#, c-format
msgid "In the directive number %zu, \"%s\" is not followed by a comma."
msgstr "При директива номер %zu, \"%s\" не е последван от запетая."

#: src/format-java.c:272
#, c-format
msgid ""
"In the directive number %zu, the substring \"%s\" is not a valid number "
"style."
msgstr "При директива номер %zu, низът \"%s\" не е правилен за число."

#: src/format-java.c:321
#, c-format
msgid ""
"In the directive number %zu, the argument number is not followed by a comma "
"and one of \"%s\", \"%s\", \"%s\", \"%s\"."
msgstr ""
"При директива номер %zu, номера на аргумент не е последван от запетая или "
"някой от \"%s\", \"%s\", \"%s\", \"%s\"."

#: src/format-java.c:566
#, c-format
msgid "In the directive number %zu, a choice contains no number."
msgstr "При директива номер %zu, избора е без число."

#: src/format-java.c:577
#, c-format
msgid ""
"In the directive number %zu, a choice contains a number that is not followed "
"by '<', '#' or '%s'."
msgstr ""
"При директива номер %zu, избора съдържа число, което не е последвано от '<', "
"'#' или '%s'."

#: src/format-java.c:738
#, c-format
msgid ""
"a format specification for argument {%zu}, as in '%s', doesn't exist in '%s'"
msgstr ""
"указаният формат за аргумент {%zu}, както е при '%s', не съществува в '%s'"

#: src/format-java.c:750
#, c-format
msgid "a format specification for argument {%zu} doesn't exist in '%s'"
msgstr "указаният формат за аргумент {%zu} не съществува в '%s'"

#: src/format-java.c:774
#, c-format
msgid ""
"format specifications in '%s' and '%s' for argument {%zu} are not the same"
msgstr "не са еднакви указаните формати при '%s' и при '%s' за аргумент {%zu}"

#: src/format-java-printf.c:131
#, c-format
msgid ""
"In the directive number %zu, the reference to the argument of the previous "
