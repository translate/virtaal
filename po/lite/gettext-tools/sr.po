msgstr ""
"У смерници број %zu, „getattr“ аргумент почиње знаком који није "
"алфанумерички или подвлака."

#: src/format-python-brace.c:216
#, c-format
msgid "In the directive number %zu, '%c' cannot start a getitem argument."
msgstr "У смерници број %zu, „%c“ не може да започне аргумент „getitem“."

#: src/format-python-brace.c:218
#, c-format
msgid ""
"In the directive number %zu, a getitem argument starts with a character that "
"is not alphanumerical or underscore."
msgstr ""
"У смерници број %zu, „getitem“ аргумент почиње знаком који није "
"алфанумерички или подвлака."

#: src/format-python-brace.c:228
#, c-format
msgid "In the directive number %zu, there is an unterminated getitem argument."
msgstr "У смерници број %zu, постоји неокончани „getitem“ аргумент."

#: src/format-python-brace.c:251
#, c-format
