#: src/format-python-brace.c:555
#: src/format-python.c:486
#: src/format-ruby.c:910
#: src/format-rust.c:461
#: src/format-sh.c:295
#, c-format
msgid "a format specification for argument '%s' doesn't exist in '%s'"
msgstr "одредба записа за аргумент „%s“ не постоји у „%s“"

#: src/format-perl.c:426
#, c-format
msgid ""
"In the directive number %zu, the size specifier is incompatible with the "
