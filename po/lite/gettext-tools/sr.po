msgstr[2] ""
"У смерници број %zu, дато је превише параметара; очекивах највише %zu "
"параметара."

#: src/format-lisp.c:2492
#: src/format-scheme.c:2494
#, c-format
msgid "In the directive number %zu, '%c' is not followed by a digit."
msgstr "У смерници број %zu, након „%c“ не следи цифра."

#: src/format-lisp.c:2734
#: src/format-scheme.c:2751
#, c-format
msgid "In the directive number %zu, the argument %d is negative."
msgstr "У смерници број %zu, %d. аргумент је негативан."

#: src/format-lisp.c:2803
msgid "The string ends in the middle of a ~/.../ directive."
msgstr "Ниска се завршава у сред смернице ~/.../."

#: src/format-lisp.c:2841
#: src/format-lisp.c:3097
#: src/format-lisp.c:3214
#: src/format-lisp.c:3274
#: src/format-lisp.c:3386
#: src/format-scheme.c:2837
#: src/format-scheme.c:3093
#: src/format-scheme.c:3210
#: src/format-scheme.c:3308
