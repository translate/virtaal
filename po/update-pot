# Regenerates po/virtaal.pot from po/POTFILES.in. Replaces intltool-
# update --pot.
#
# xgettext can't tell a .desktop.in or a GtkBuilder .ui file from
# plain text/XML by extension, so those get their own -L pass;
# --join-existing accumulates every pass into one pot. The final pass
# auto-detects the rest: .py files, the metainfo template via
# gettext's bundled metainfo.its, and virtaal-mimetype.xml.in via
# po/its/ (found through GETTEXTDATADIRS below).
set -euo pipefail
cd "$(dirname "$0")"

gettextdatadirs="$PWD${GETTEXTDATADIRS:+:$GETTEXTDATADIRS}"
export GETTEXTDATADIRS="$gettextdatadirs"

version=$(grep -E '^ver ' ../virtaal/__version__.py | sed 's/ver = //;s/"//g')
common_args=(
    --directory=..
    --from-code=UTF-8
    --add-comments=l10n
    --add-location=file
    --copyright-holder="Zuza Software Foundation (Translate.org.za)"
    --package-name=Virtaal
    --package-version="$version"
    --msgid-bugs-address=translate-devel@lists.sourceforge.net
)

out=virtaal.pot
rm -f "$out"

desktop_files=()
glade_files=()
default_files=()

while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        share/applications/*.desktop.in) desktop_files+=("$f") ;;
        *.ui) glade_files+=("$f") ;;
        *) default_files+=("$f") ;;
    esac
done < POTFILES.in

joined=""
run_group() {
    if [ -n "$joined" ]; then
        xgettext "${common_args[@]}" --join-existing "$@" -o "$out"
    else
        xgettext "${common_args[@]}" "$@" -o "$out"
    fi
    joined=1
}

[ "${#desktop_files[@]}" -gt 0 ] && run_group -L Desktop "${desktop_files[@]}"
[ "${#glade_files[@]}" -gt 0 ] && run_group -L Glade "${glade_files[@]}"
[ "${#default_files[@]}" -gt 0 ] && run_group "${default_files[@]}"
