<component type="desktop-application">
 <id>io.github.translate.Virtaal</id>
 <metadata_license>CC-BY-SA-3.0</metadata_license>
 <project_license>GPL-2.0-or-later</project_license>
 <!-- l10n: The name should be less than 30 characters -->
 <name>Virtaal Translation Tool</name>
 <!-- l10n: The summary should be less than 100 characters -->
 <summary>Translation tool to help a human translator translate files into other languages</summary>
 <description>
  <!-- l10n: Paragraphs should be less than 600 characters -->
  <p>
    Virtaal is a program for doing translation. It aims for a delightful combination of simplicity and power. It integrates with selected online resources to make translation fun, while helping to improve translation quality.
  </p>
  <p>
    The initial focus is on software translation (localization or l10n), but is definitely meant to be useful as a general purpose tool for Computer Aided Translation (CAT).
  </p>
  <p>Some features:</p>
  <ul>
   <!-- l10n: These list items should be less than 100 characters -->
   <li>Translation reuse (translation memory)</li>
   <li>Terminology assistance</li>
   <li>AutoCompletor and AutoCorrector</li>
   <li>Quality checks with customization for many languages</li>
  </ul>
 </description>
 <screenshots>
  <screenshot type="default">
    <image>https://raw.githubusercontent.com/translate/virtaal/main/docs/_static/appdata/welcome.png</image>
    <!-- l10n: Captions should be shorter than 50 characters -->
    <caption>Easy access to recent files and documentation</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/translate/virtaal/main/docs/_static/appdata/placeable.png</image>
    <caption>Recognized elements don't need to be typed</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/translate/virtaal/main/docs/_static/appdata/window.png</image>
    <caption>Quality checks while you type</caption>
  </screenshot>
 </screenshots>
 <url type="homepage">https://virtaal.translatehouse.org</url>
